# ── Groq API ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Qdrant Vector Database ─────────────────────────────────────────────────
# Local (docker-compose): leave QDRANT_URL empty, set HOST + PORT
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=tenant_corpus

# Cloud (Qdrant Cloud free tier): set QDRANT_URL + QDRANT_API_KEY, leave HOST/PORT defaults
# QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://documind:documind_dev@localhost:5432/documind

# ── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Embedding & Cross-Encoder Models ───────────────────────────────────────
DENSE_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ── File Upload ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads          # use /tmp/uploads on ephemeral cloud hosting

# ── Application Settings ───────────────────────────────────────────────────
APP_NAME=DocuMind
ENV=development
DEBUG=true

# ── CORS (comma-separated list of allowed origins) ─────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
